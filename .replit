modules = ["nodejs-20", "dotnet-8.0", "postgresql-16", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = [
  "file",
  "glibcLocales",
  "openssl",
  "postgresql",
  "dotnetCorePackages.sdk_8_0_2xx",
]

[deployment]
deploymentTarget = "autoscale"
run = ["dotnet", "publish/ORCA.Api.dll"]
build = ["dotnet", "publish", "ORCA.Api/ORCA.Api.csproj", "-c", "Release", "-o", "publish"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ORCA.Api && dotnet run --configuration Release"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[env]
DOTNET_ROOT = "$HOME/.dotnet"
PATH = "$PATH:$HOME/.dotnet:$HOME/.dotnet/tools"
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT = "1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
